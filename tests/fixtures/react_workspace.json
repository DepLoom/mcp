  "source": {
    "package.json": "{\n  \"name\": \"deploom-react-monorepo-control\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"dependencies\": {\n    \"react\": \"18.3.1\"\n  },\n  \"scripts\": {\n    \"test\": \"node packages/app/main.cjs && node packages/legacy/main.cjs\"\n  }\n}\n",
    "packages/app/package.json": "{\n  \"name\": \"deploom-control-app\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"react\": \"18.3.1\",\n    \"react-dom\": \"18.3.1\",\n    \"deploom-control-ui\": \"1.0.0\",\n    \"is-number\": \"7.0.0\"\n  }\n}\n",
    "packages/legacy/package.json": "{\n  \"name\": \"deploom-control-legacy\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"react\": \"18.3.1\",\n    \"react-dom\": \"18.3.1\"\n  }\n}\n",
    "packages/ui/package.json": "{\n  \"name\": \"deploom-control-ui\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"main\": \"index.cjs\",\n  \"peerDependencies\": {\n    \"react\": \"^18.3.1 || ^19.0.0\"\n  }\n}\n",
    "packages/app/main.cjs": "const assert = require(\"node:assert/strict\");\nconst React = require(\"react\");\nconst ui = require(\"deploom-control-ui\");\nconst { renderToStaticMarkup } = require(\"react-dom/server\");\nassert.equal(React.version, \"18.3.1\");\nassert.equal(require(\"react-dom\").version, \"18.3.1\");\nassert.strictEqual(React, ui.react);\nassert.equal(require(\"is-number/package.json\").version, \"7.0.0\");\nfor (const initial of [0, 17, -6]) {\n  assert.equal(renderToStaticMarkup(React.createElement(ui.Counter, { initial })), `<strong>${initial}</strong>`);\n}\n",
    "packages/legacy/main.cjs": "const assert = require(\"node:assert/strict\");\nconst React = require(\"react\");\nconst { renderToStaticMarkup } = require(\"react-dom/server\");\nassert.equal(React.version, \"18.3.1\");\nassert.equal(require(\"react-dom\").version, \"18.3.1\");\nfunction Probe() {\n  const [value] = React.useState(\"legacy\");\n  return React.createElement(\"i\", null, value);\n}\nassert.equal(renderToStaticMarkup(React.createElement(Probe)), \"<i>legacy</i>\");\n",
    "packages/ui/index.cjs": "const React = require(\"react\");\nexports.react = React;\nexports.Counter = function Counter({ initial }) {\n  const [count] = React.useState(initial);\n  return React.createElement(\"strong\", null, count);\n};\n"
  },
